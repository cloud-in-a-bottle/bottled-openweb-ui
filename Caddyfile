{
	admin off
	auto_https off
	persist_config off
}

# Local sidecar in front of Open WebUI (which listens on loopback :8081).
# Serves the container's public port and adds the security headers Open WebUI
# does not set, so the owner UI can't be framed (clickjacking) or MIME-sniffed.
:8080 {
	header {
		# `defer` applies these after the proxied response, so they win.
		defer
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		# "same-origin", NOT "no-referrer": under a no-referrer policy Chromium
		# sends "Origin: null" on POST requests, and the OpenHost router rejects
		# owner-authenticated POSTs whose Origin doesn't match the app host,
		# which breaks the app's own API calls. same-origin still withholds the
		# Referer cross-origin while sending a correct same-origin Origin.
		Referrer-Policy "same-origin"
		# The app is only ever served over HTTPS (the OpenHost router
		# terminates TLS), so pin the browser to HTTPS. No includeSubDomains:
		# this app owns only its own subdomain and shouldn't assert an HTTPS
		# policy over any child names.
		Strict-Transport-Security "max-age=31536000"
	}

	reverse_proxy 127.0.0.1:8081 {
		# Retry (rather than 502) while Open WebUI is binding :8081 on a
		# start or restart, so brief races don't flap the health check.
		# Kept modest so a genuinely dead upstream still fails in a bounded
		# time; the platform's own startup grace covers a rare first-boot
		# model download that runs longer than this.
		lb_try_duration 60s
	}
}
